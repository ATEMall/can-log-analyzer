{
  "appId": "com.canlog.analyzer.pro",
  "productName": "CAN Log Analyzer Pro",
  "electronDist": "node_modules/electron/dist",
  "directories": {
    "output": "release_new"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "package.json"
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": null
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "CAN Log Analyzer Pro",
    "installerIcon": null,
    "uninstallerIcon": null,
    "uninstallDisplayName": "CAN Log Analyzer Pro"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}.${ext}"
  }
}
