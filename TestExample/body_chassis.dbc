CM_ BO_ 1024 "Door and window status - 200ms cycle";
CM_ SG_ 1024 DoorOpen_FL "Front left door open status - 0:Closed, 1:Open";
CM_ SG_ 1024 DoorLockStatus "Door lock status: 0:Unlocked, 1:Locked, 2:Superlocked";
CM_ SG_ 1024 ChildLockActive "Child lock active status";

CM_ BO_ 1280 "External lighting and wiper status - 100ms cycle";
CM_ SG_ 1280 HeadLight "Headlight: 0:Off, 1:Position, 2:LowBeam, 3:Auto";
CM_ SG_ 1280 TurnSignal "Turn signal: 0:Off, 1:Left, 2:Right, 3:Hazard";
CM_ SG_ 1280 WiperSpeed "Wiper: 0:Off, 1:Intermittent, 2:Low, 3:High";

CM_ BO_ 1536 "Chassis dynamics data - 10ms cycle";
CM_ SG_ 1536 SteeringAngle "Steering wheel angle, positive = left turn";
CM_ SG_ 1536 YawRate "Vehicle yaw rate";

